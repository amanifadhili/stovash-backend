              "raw": "{\n  \"command\": \"RecordPartialPayment\",\n  \"payload\": {\n    \"salesOrderId\": \"so-1001\",\n    \"amount\": 250,\n    \"paymentMethod\": \"CASH\"\n  },\n  \"context\": {\n    \"tenantId\": \"{{tenantId}}\",\n    \"shopId\": \"{{shopId}}\",\n    \"userId\": \"{{userId}}\",\n    \"traceId\": \"{{$guid}}\"\n  }\n}"
