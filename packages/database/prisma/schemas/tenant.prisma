// Tenant Service Database Schema
// Handles: Tenants, Shops, Staff, Roles, Permissions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shops     Shop[]
  staff     Staff[]

  @@index([status])
  @@map("tenants")
}

model Shop {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  location    String?
  status      String   @default("ACTIVE") // ACTIVE, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  staff       Staff[]
  workPeriods WorkPeriod[]

  @@index([tenantId])
  @@index([status])
  @@map("shops")
}

model Staff {
  id        String   @id @default(uuid())
  tenantId  String
  shopId    String?
  userId    String   @unique
  firstName String
  lastName  String
  email     String
  role      String   @default("STAFF") // ADMIN, MANAGER, STAFF
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  shop        Shop?        @relation(fields: [shopId], references: [id])

  @@index([tenantId])
  @@index([shopId])
  @@index([userId])
  @@index([email])
  @@map("staff")
}

model WorkPeriod {
  id        String    @id @default(uuid())
  shopId    String
  openedBy  String    // staffId
  closedBy  String?   // staffId
  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  status    String    @default("OPEN") // OPEN, CLOSED

  shop      Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([status])
  @@map("work_periods")
}
