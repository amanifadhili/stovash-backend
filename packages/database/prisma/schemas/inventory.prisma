// Inventory Service Database Schema
// Handles: Products, Inventory Items, Serials, Categories, Movements

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("INVENTORY_DATABASE_URL")
}

model Contact {
  id         String   @id @default(uuid())
  tenantId   String
  shopId     String?
  name       String
  phone      String?
  email      String?
  address    String?
  type       String   @default("RENTAL") // RENTAL, SUPPLIER, CUSTOMER, GENERAL
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([shopId])
  @@index([type])
  @@map("contacts")
}

model Product {
  id               String   @id @default(uuid())
  tenantId         String
  name             String
  description      String?
  sku              String
  brandId          String?
  model            String?
  categoryId       String?
  status           String   @default("ACTIVE") // ACTIVE, DISCONTINUED
  createdAt        DateTime @default(now())
  createdBy        String?
  updatedAt        DateTime @updatedAt
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?
  version          Int      @default(1)
  productType      String   @default("PHYSICAL_GOOD")
  specifications   Json?
  trackingMethod   String   @default("SERIALIZED")
  shopId           String?
  sharedShopIds    String[] @default([])
  quantityOnHand   Float    @default(0)
  type             String   @default("DEVICE")

  items            InventoryItem[]
  attributes       ProductAttribute[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([shopId])
  @@map("products")
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  name      String
  value     String
  createdAt DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_attributes")
}

model InventoryItem {
  id               String   @id @default(uuid())
  tenantId         String
  shopId           String
  productId        String
  serialNumber     String
  purchaseCost     Float
  status           String   @default("CREATED") // CREATED, RECEIVED, AVAILABLE, RESERVED, SOLD, RETURNED, DAMAGED, LOST, STOLEN, DISPOSED, RENTED_OUT
  capitalizedCost  Float    @default(0)
  createdAt        DateTime @default(now())
  createdBy        String?
  updatedAt        DateTime @updatedAt
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?
  version          Int      @default(1)
  imageUrl         String?
  specifications   Json?

  product          Product          @relation(fields: [productId], references: [id])
  movements        InventoryMovement[]
  adjustments      InventoryAdjustment[]
  rentalAgreements RentalAgreement[]
  upgrades         InventoryUpgrade[]

  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@index([shopId])
  @@index([productId])
  @@index([status])
  @@map("inventory_items")
}

model InventoryCategory {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  parentId      String?
  createdAt     DateTime @default(now())
  createdBy     String?
  shopId        String?
  sharedShopIds String[] @default([])

  parent        InventoryCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      InventoryCategory[] @relation("CategoryHierarchy")

  @@index([tenantId])
  @@index([parentId])
  @@index([shopId])
  @@map("categories")
}

model InventoryBrand {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  createdAt     DateTime @default(now())
  createdBy     String?
  shopId        String?
  sharedShopIds String[] @default([])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([shopId])
  @@map("brands")
}

model InventoryMovement {
  id               String   @id @default(uuid())
  tenantId         String
  shopId           String
  inventoryItemId  String?  // Changed to match existing table
  movementType     String   // Changed to match existing table: RECEIPT, TRANSFER, SALE, RETURN, ADJUSTMENT
  quantity         Float    @default(1)
  referenceId      String?  // PurchaseOrder, SalesOrder, RentalAgreement, etc.
  referenceType    String? // PURCHASE, SALE, RENTAL_CONVERTED_SALE, etc.
  notes            String?
  createdAt        DateTime @default(now())
  createdBy        String?
  customerId       String?
  productId        String?

  item             InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([tenantId])
  @@index([shopId])
  @@index([inventoryItemId])
  @@index([movementType])
  @@index([productId])
  @@index([referenceType])
  @@index([createdAt])
  @@map("inventory_movements")
}

model InventoryAdjustment {
  id            String   @id @default(uuid())
  tenantId      String
  shopId        String
  itemId        String
  type          String   // DAMAGE, LOSS, THEFT, CORRECTION
  quantity      Float
  reason        String?
  approvedBy    String?  // userId
  createdAt     DateTime @default(now())

  item          InventoryItem @relation(fields: [itemId], references: [id])

  @@index([tenantId])
  @@index([shopId])
  @@index([itemId])
  @@index([type])
  @@map("inventory_adjustments")
}

model RentalAgreement {
  id               String   @id @default(uuid())
  tenantId         String
  shopId           String
  inventoryItemId  String?  // Optional: specific serialized item
  productId        String?  // Optional: product-level (for non-serialized items)
  customerId       String?  // Optional: link to existing customer
  personName       String   // Required: person name (fallback if no customerId)
  personPhone      String?  // Optional: person phone
  agreementType    String   // OUTWARD_RENTAL, INWARD_CONSIGNMENT
  startDate        DateTime @default(now())
  expectedReturn   DateTime? // Optional: expected return date
  actualReturn     DateTime? // Set when returned/closed
  rentalFee        Float    @default(0) // Agreed rental fee (optional)
  ownerAgreedCost  Float    @default(0) // Owner agreed cost (for consignment)
  maintenanceCost  Float    @default(0) // Maintenance cost incurred
  status           String   @default("ACTIVE") // ACTIVE, RETURNED, SOLD, CANCELLED
  notes            String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inventoryItem    InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  @@index([tenantId])
  @@index([shopId])
  @@index([inventoryItemId])
  @@index([customerId])
  @@index([status])
  @@map("rental_agreements")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  shopId     String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  traceId    String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model InventoryTransfer {
  id             String   @id @default(uuid())
  tenantId       String
  fromShopId     String
  toShopId       String
  transferNumber String   @unique
  serialNumber   String
  status         String   @default("COMPLETED") // IN_TRANSIT, COMPLETED, CANCELLED
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@map("inventory_transfers")
}

model InventoryUpgrade {
  id            String   @id @default(uuid())
  tenantId      String
  shopId        String
  inventoryItemId String
  upgradeType   String   // SSD, RAM, etc.
  description   String?
  cost          Float
  createdAt     DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([tenantId])
  @@index([shopId])
  @@index([inventoryItemId])
  @@map("inventory_upgrades")
}

model ProductPrice {
  id           String   @id @default(uuid())
  productId    String
  tenantId     String
  sellingPrice Float
  validFrom    DateTime @default(now())
  validTo      DateTime?
  createdAt    DateTime @default(now())
  createdBy    String?

  @@index([productId])
  @@index([tenantId])
  @@map("product_prices")
}

model WarrantyClaim {
  id               String   @id @default(uuid())
  tenantId         String
  shopId           String
  serialNumber     String
  customerName     String?
  issueDescription String
  status           String   @default("LOGGED") // LOGGED, IN_REPAIR, REPLACED, CLOSED
  resolution       String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@index([shopId])
  @@index([serialNumber])
  @@map("warranty_claims")
}
