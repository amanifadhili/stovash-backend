{
  "info": {
    "_postman_id": "c2000010-ac00-4000-8000-fileserv2",
    "name": "File Service API Collection",
    "description": "Postman collection for file upload, download, deletion, and S3 integration.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "File Operations",
      "item": [
        {
          "name": "Upload File",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"UploadFile\",\n  \"data\": {\n    \"file\": \"base64_encoded_file_content\",\n    \"filename\": \"document.pdf\",\n    \"contentType\": \"application/pdf\",\n    \"tenantId\": \"{{tenantId}}\",\n    \"category\": \"invoices\"\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:3011",
              "host": ["localhost"],
              "port": "3011"
            }
          }
        },
        {
          "name": "Delete File",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"DeleteFile\",\n  \"data\": {\n    \"key\": \"{{tenantId}}/invoices/1234567890-uuid.pdf\"\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:3011",
              "host": ["localhost"],
              "port": "3011"
            }
          }
        },
        {
          "name": "Get File URL",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"GetFileUrl\",\n  \"data\": {\n    \"key\": \"{{tenantId}}/invoices/1234567890-uuid.pdf\",\n    \"expiresIn\": 3600\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:3011",
              "host": ["localhost"],
              "port": "3011"
            }
          }
        },
        {
          "name": "Generate Presigned URL",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"GeneratePresignedUrl\",\n  \"data\": {\n    \"key\": \"{{tenantId}}/uploads/new-file.pdf\",\n    \"operation\": \"putObject\",\n    \"expiresIn\": 3600\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:3011",
              "host": ["localhost"],
              "port": "3011"
            }
          }
        }
      ]
    }
  ]
}
