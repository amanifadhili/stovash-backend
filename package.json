{
  "name": "electronic-shop-ms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "frontend/*",
    "packages/*",
    "frameworks/*"
  ],
  "scripts": {
    "start": "node dist/server.js",
    "build": "npm run build --workspace=packages/types --workspace=packages/database --workspace=frameworks/core --workspace=frameworks/command && npm run build --workspaces --if-present && tsc -p tsconfig.server.json",
    "dev": "tsx server.ts",
    "test": "tsx ./run-tests.ts",
    "lint": "echo Linting disabled"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "tsx": "^4.23.9",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@nestjs/cqrs": "^11.0.3",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "lucide-react": "^1.31.0",
    "nodemailer": "^9.0.5",
    "recharts": "^3.10.1",
    "uuid": "^14.0.1"
  }
}
