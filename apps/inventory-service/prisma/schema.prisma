// Inventory Service Database Schema
// Handles: Products, Inventory Items, Transfers, Upgrades, Warranty Claims, Movements
// Owner of: inventory_db

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("INVENTORY_DATABASE_URL")
}

model Contact {
  id         String   @id @default(uuid())
  tenantId   String
  shopId     String?
  name       String
  phone      String?
  email      String?
  address    String?
  type       String   @default("RENTAL") // RENTAL, SUPPLIER, CUSTOMER, GENERAL, SHOP
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([shopId])
  @@index([type])
  @@map("contacts")
}

model Product {
  id             String   @id @default(uuid())
  tenantId       String
  shopId         String?  // null = shared with ALL shops; set = owner shop
  sharedShopIds  String[] @default([]) // additional shops chosen to share with
  type           String   @default("DEVICE") // DEVICE, ACCESSORY
  sku            String
  name           String
  description    String?
  brandId        String?
  categoryId     String?
  productType    String   @default("PHYSICAL_GOOD") // PHYSICAL_GOOD, SERVICE
  trackingMethod String   @default("SERIALIZED")    // SERIALIZED, NON_SERIALIZED
  status         String   @default("ACTIVE")        // DRAFT, ACTIVE, INACTIVE, DISCONTINUED, ARCHIVED
  specifications Json?                              // [{key, value, type, sortOrder}]
  quantityOnHand  Float    @default(0) // non-serialized stock level
  imageUrl        String?  // primary image for accessory / package display
  images          String[] @default([]) // package photos (data URLs or remote URLs)
  createdAt      DateTime @default(now())
  createdBy      String?
  updatedAt      DateTime @updatedAt
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?
  version        Int      @default(1)

  brand    Brand?        @relation(fields: [brandId], references: [id])
  category Category?     @relation(fields: [categoryId], references: [id])
  items    InventoryItem[]
  prices   ProductPrice[]
  shopBalances ShopProductBalance[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([shopId])
  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

/// Per-shop quantity for non-serialized (accessory) stock.
/// Product.quantityOnHand is kept as a denormalized sum across shops for one release.
model ShopProductBalance {
  id             String   @id @default(uuid())
  tenantId       String
  shopId         String
  productId      String
  quantityOnHand Float    @default(0)
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@unique([tenantId, shopId, productId])
  @@index([tenantId, shopId])
  @@index([productId])
  @@map("shop_product_balances")
}

model InventoryItem {
  id              String   @id @default(uuid())
  tenantId        String
  shopId          String
  productId       String
  /// Stock-owned display fields (not shared catalog). Prefer these over Product.*.
  name            String?
  brandId         String?
  categoryId      String?
  sellingPrice    Float?
  specifications  Json?
  imei1           String?
  imei2           String?
  condition       String?
  notes           String?
  images          String[] @default([])
  serialNumber    String
  purchaseCost    Float
  status          String   @default("CREATED") // CREATED, RECEIVED, AVAILABLE, RESERVED, RENTED_IN, RENTED_OUT, SOLD, RETURNED, DAMAGED, LOST, STOLEN, DISPOSED
  capitalizedCost Float    @default(0) // Total capitalized upgrade costs
  imageUrl        String?  // unit image (URL or base64 data URI), sourced from received-item images at receiving time
  createdAt       DateTime @default(now())
  createdBy       String?
  updatedAt       DateTime @updatedAt
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?
  version         Int      @default(1)

  product  Product           @relation(fields: [productId], references: [id])
  brand    Brand?            @relation(fields: [brandId], references: [id])
  category Category?         @relation(fields: [categoryId], references: [id])
  upgrades InventoryUpgrade[]

  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@index([shopId])
  @@index([productId])
  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@map("inventory_items")
}

model InventoryUpgrade {
  id              String   @id @default(uuid())
  tenantId        String
  shopId          String
  inventoryItemId String
  upgradeType     String   // SSD, RAM, MAINTENANCE, etc.
  description     String?
  details         Json?
  idempotencyKey  String?  @unique
  cost            Float
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([tenantId])
  @@index([shopId])
  @@index([inventoryItemId])
  @@index([upgradeType])
  @@map("inventory_upgrades")
}

model InventoryTransfer {
  id             String   @id @default(uuid())
  tenantId       String
  fromShopId     String
  toShopId       String
  transferNumber String   @unique
  serialNumber   String
  status         String   @default("COMPLETED") // IN_TRANSIT, COMPLETED, CANCELLED
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([fromShopId])
  @@index([toShopId])
  @@index([status])
  @@map("inventory_transfers")
}

model WarrantyClaim {
  id               String   @id @default(uuid())
  tenantId         String
  shopId           String
  serialNumber     String
  customerName     String?
  issueDescription String
  status           String   @default("LOGGED") // LOGGED, IN_REPAIR, REPLACED, CLOSED
  resolution       String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@index([shopId])
  @@index([serialNumber])
  @@index([status])
  @@map("warranty_claims")
}

model Category {
  id            String   @id @default(uuid())
  tenantId      String
  shopId        String?  // null = shared with ALL shops; set = owner shop
  sharedShopIds String[] @default([]) // additional shops chosen to share with
  name          String
  parentId      String?
  createdAt     DateTime @default(now())
  createdBy     String?

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  stockItems InventoryItem[]

  @@index([tenantId])
  @@index([shopId])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id            String   @id @default(uuid())
  tenantId      String
  shopId        String?  // null = shared with ALL shops; set = owner shop
  sharedShopIds String[] @default([]) // additional shops chosen to share with
  name          String
  description   String?
  createdAt     DateTime @default(now())
  createdBy     String?

  products Product[]
  stockItems InventoryItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([shopId])
  @@map("brands")
}

model ProductPrice {
  id           String   @id @default(uuid())
  productId    String
  tenantId     String
  sellingPrice Float
  validFrom    DateTime @default(now())
  validTo      DateTime?
  createdAt    DateTime @default(now())
  createdBy    String?

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([tenantId])
  @@map("product_prices")
}

model InventoryMovement {
  id              String   @id @default(uuid())
  tenantId        String
  shopId          String
  inventoryItemId String?  // set for serialized items; null for product-level (non-serialized) movement
  productId       String?  // set for non-serialized product-level movement
  customerId      String?  // customer linked to a SALE out-movement
  movementType    String   // IN, OUT, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT
  quantity        Float    @default(1)
  referenceId     String?
  referenceType   String?
  createdAt       DateTime @default(now())
  createdBy       String?

  @@index([tenantId])
  @@index([shopId])
  @@index([inventoryItemId])
  @@index([productId])
  @@index([movementType])
  @@index([referenceType])
  @@map("inventory_movements")
}

model InventoryAdjustment {
  id              String   @id @default(uuid())
  tenantId        String
  shopId          String
  inventoryItemId String
  adjustmentType  String   // DAMAGE, LOSS, THEFT, DISPOSAL, CORRECTION
  reason          String?
  quantity        Float    @default(1)
  createdAt       DateTime @default(now())
  createdBy       String?

  @@index([tenantId])
  @@index([shopId])
  @@index([inventoryItemId])
  @@index([adjustmentType])
  @@map("inventory_adjustments")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  shopId     String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  traceId    String?
  details    String?  // JSON or text summary
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model RentalAgreement {
  id               String    @id @default(uuid())
  tenantId         String
  shopId           String
  inventoryItemId  String?   // For serialized device rental/consignment
  productId        String?   // For non-serialized accessory
  contactId        String?   // Neighbor shop (Contact type SHOP)
  personName       String    // Shop name (or person name for legacy rows)
  personPhone      String?
  agreementType    String    // OUTWARD_RENTAL, INWARD_CONSIGNMENT
  startDate        DateTime  @default(now())
  expectedReturn   DateTime?
  actualReturn     DateTime?
  rentalFee        Float?    // Agreed fee / rate for outward rental
  ownerAgreedCost  Float?    // Locked floor price spoken at collect (Store B min / our min)
  salePrice        Float?    // Customer sale price when the rental is sold
  ownerPayoutTotal Float?    // Amount paid to the owner on sale
  ownerPayoutDetails Json?   // [{ method, amount, reference }]
  commissionAmount Float?    // Lend-IN: salePrice - floor - extras. Lend-OUT settle: floor - our cost.
  maintenanceCost  Float     @default(0) // Extras at sale (bag/charger/cash), not added to floor
  quantity         Float     @default(1) // Accessory qty hold; devices stay 1
  status           String    @default("ACTIVE") // ACTIVE, RETURNED, SOLD, SETTLED, CANCELLED
  notes            String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId])
  @@index([shopId])
  @@index([agreementType])
  @@index([status])
  @@index([contactId])
  @@map("rental_agreements")
}
