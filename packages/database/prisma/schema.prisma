// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shops     Shop[]
  users     User[]
}

model Shop {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  location    String?
  address     String?
  phone       String?
  status      String   @default("ACTIVE") // ACTIVE, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  workPeriods WorkPeriod[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      String   @default("STAFF") // ADMIN, MANAGER, STAFF
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model WorkPeriod {
  id            String    @id @default(uuid())
  tenantId      String?
  shopId        String
  openedBy      String    // userId
  closedBy      String?   // userId
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  status        String    @default("OPEN") // OPEN, CLOSED
  totalRevenue  Float     @default(0)
  totalExpense  Float     @default(0)
  netProfit     Float     @default(0)
  grossProfit   Float     @default(0)

  shop          Shop      @relation(fields: [shopId], references: [id])
}

model LedgerAccount {
  id          String   @id @default(uuid())
  tenantId    String
  shopId      String
  code        String
  name        String
  type        String   // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  balance     Float    @default(0)
  parentId    String?  // Parent account for hierarchy
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  entries     LedgerEntry[]
  parent      LedgerAccount? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    LedgerAccount[] @relation("AccountHierarchy")

  @@index([tenantId])
  @@index([shopId])
  @@index([parentId])
}

model JournalEntry {
  id          String   @id @default(uuid())
  tenantId    String
  shopId      String
  workPeriodId String
  description String
  postedBy    String   // userId
  status      String   @default("DRAFT") // DRAFT, POSTED
  batchId     String?  // Reference to posting batch
  createdAt   DateTime @default(now())
  entries     LedgerEntry[]
  batch       PostingBatch? @relation(fields: [batchId], references: [id])
}

model PostingBatch {
  id          String   @id @default(uuid())
  tenantId    String
  shopId      String
  workPeriodId String
  name        String
  description String?
  status      String   @default("DRAFT") // DRAFT, POSTED
  postedBy    String?  // userId
  postedAt    DateTime?
  createdAt   DateTime @default(now())
  journalEntries JournalEntry[]
}

model LedgerEntry {
  id             String   @id @default(uuid())
  journalEntryId String
  accountId      String
  type           String   // DEBIT, CREDIT
  amount         Float
  createdAt      DateTime @default(now())

  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id])
  account        LedgerAccount @relation(fields: [accountId], references: [id])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  sku         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       InventoryItem[]
}

model InventoryItem {
  id            String   @id @default(uuid())
  tenantId      String
  shopId        String
  productId     String
  serialNumber  String
  purchaseCost  Float
  status        String   @default("CREATED") // CREATED, RECEIVED, AVAILABLE, RESERVED, SOLD, RETURNED, DAMAGED, LOST, STOLEN, DISPOSED, RENTED_OUT
  capitalizedCost Float  @default(0) // Total capitalized upgrade costs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product  @relation(fields: [productId], references: [id])
  upgrades      InventoryUpgrade[]
  rentalAgreement RentalAgreement?
  movements     InventoryMovement[]
}

model InventoryUpgrade {
  id            String   @id @default(uuid())
  tenantId      String
  shopId        String
  inventoryItemId String
  upgradeType   String   // SSD, RAM, MAINTENANCE, etc.
  description   String?
  details       Json?
  idempotencyKey String?  @unique
  cost          Float
  createdAt     DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

model SalesOrder {
  id                  String           @id @default(uuid())
  tenantId            String
  shopId              String
  customerId          String?
  workPeriodId        String?
  orderNumber         String           @unique
  totalAmount         Float
  totalCost           Float
  profit              Float?
  paymentMethod       String           @default("CASH") // CASH, CARD, CREDIT
  status              String           @default("COMPLETED") // COMPLETED, CANCELLED, REFUNDED, ACTIVE_LOAN
  downPayment         Float            @default(0)
  loanAmount          Float            @default(0)
  interestRate        Float            @default(0)
  totalInterest       Float            @default(0)
  totalRepayment      Float            @default(0)
  numberOfInstallments Int              @default(0)
  installmentAmount   Float            @default(0)
  createdById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  items               SalesOrderItem[]
  loanPayments        LoanPayment[]
  customer            Customer?       @relation(fields: [customerId], references: [id])
}

model SalesOrderItem {
  id              String   @id @default(uuid())
  salesOrderId    String
  inventoryItemId String
  serialNumber    String
  unitCost        Float
  unitPrice       Float
  createdAt       DateTime @default(now())

  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  tenantId     String
  shopId       String
  poNumber     String              @unique
  vendorName   String
  totalAmount  Float
  status       String              @default("RECEIVED") // PENDING, RECEIVED, CANCELLED
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  items        PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  serialNumber    String
  purchaseCost    Float
  createdAt       DateTime      @default(now())

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model SalesReturn {
  id           String   @id @default(uuid())
  tenantId     String
  shopId       String
  workPeriodId String?
  returnNumber String   @unique
  salesOrderId String?
  serialNumber String
  refundAmount Float
  cogsAmount   Float    @default(0)
  reason       String?
  restock      Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
}

model WarrantyClaim {
  id               String   @id @default(uuid())
  tenantId         String
  shopId           String
  serialNumber     String
  customerName     String?
  issueDescription String
  status           String   @default("LOGGED") // LOGGED, IN_REPAIR, REPLACED, CLOSED
  resolution       String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Bonus {
  id            String   @id @default(uuid())
  tenantId      String
  shopId        String
  workPeriodId  String
  recipientType String   // STAFF, CUSTOMER
  recipientId   String
  amount        Float
  reason        String
  salesOrderId  String?
  recordedBy    String
  createdAt     DateTime @default(now())
}

model LoanPayment {
  id           String   @id @default(uuid())
  salesOrderId String
  tenantId     String
  shopId       String
  dueDate      DateTime
  amount       Float
  status       String   @default("PENDING") // PENDING, PAID, OVERDUE
  paidAt       DateTime?
  createdAt    DateTime @default(now())
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
}

model InventoryTransfer {
  id             String   @id @default(uuid())
  tenantId       String
  fromShopId     String
  toShopId       String
  transferNumber String   @unique
  serialNumber   String
  status         String   @default("COMPLETED") // IN_TRANSIT, COMPLETED, CANCELLED
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model InventoryMovement {
  id            String   @id @default(uuid())
  tenantId      String
  shopId        String
  inventoryItemId String
  movementType  String   // IN, OUT, TRANSFER, ADJUSTMENT
  quantity      Float    @default(1)
  referenceId   String?  // PurchaseOrder, SalesOrder, RentalAgreement, etc.
  referenceType String? // PURCHASE, SALE, RENTAL_CONVERTED_SALE, etc.
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  @@index([tenantId])
  @@index([shopId])
  @@index([inventoryItemId])
  @@index([referenceId])
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  shopId    String?
  firstName String
  lastName  String
  email     String?
  phone     String?
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger CustomerLedger?
  sales  SalesOrder[]
  @@index([tenantId])
  @@index([shopId])
}

model CustomerLedger {
  id         String        @id @default(uuid())
  tenantId   String
  shopId     String
  customerId String        @unique
  balance    Float         @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  entries  CustomerLedgerEntry[]
  @@index([tenantId])
  @@index([shopId])
}

model CustomerLedgerEntry {
  id               String   @id @default(uuid())
  customerLedgerId String
  referenceId      String?
  referenceType    String?
  debit            Float    @default(0)
  credit           Float    @default(0)
  description      String?
  balance          Float    @default(0)
  createdAt        DateTime @default(now())

  ledger CustomerLedger @relation(fields: [customerLedgerId], references: [id], onDelete: Cascade)
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  shopId    String?
  name      String
  email     String?
  phone     String?
  address   String?
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger SupplierLedger?
  @@index([tenantId])
  @@index([shopId])
}

model SupplierLedger {
  id         String        @id @default(uuid())
  tenantId   String
  shopId     String
  supplierId String        @unique
  balance    Float         @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])
  entries  SupplierLedgerEntry[]
  @@index([tenantId])
  @@index([shopId])
}

model SupplierLedgerEntry {
  id               String   @id @default(uuid())
  supplierLedgerId String
  referenceId      String?
  referenceType    String?
  debit            Float    @default(0)
  credit           Float    @default(0)
  description      String?
  balance          Float    @default(0)
  createdAt        DateTime @default(now())

  ledger SupplierLedger @relation(fields: [supplierLedgerId], references: [id], onDelete: Cascade)
}

model Staff {
  id           String   @id @default(uuid())
  tenantId     String
  shopId       String
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  role         String   @default("STAFF") // ADMIN, MANAGER, STAFF
  status       String   @default("ACTIVE")
  totalBonuses Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffRoles StaffRole[]
  @@index([tenantId])
  @@index([shopId])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  staffRoles  StaffRole[]
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model StaffRole {
  id      String   @id @default(uuid())
  staffId String
  roleId  String
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([staffId, roleId])
}

model Quotation {
  id          String           @id @default(uuid())
  tenantId    String
  shopId      String
  customerId  String?
  quoteNumber String           @unique
  totalAmount Float
  validUntil  DateTime?
  status      String           @default("DRAFT") // DRAFT, SENT, ACCEPTED, CONVERTED, EXPIRED, CANCELLED
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  items QuotationItem[]
  @@index([tenantId])
  @@index([shopId])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  productId   String
  quantity    Int
  unitPrice   Float
  discount    Float     @default(0)
  total       Float
  createdAt   DateTime  @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Sale {
  id          String      @id @default(uuid())
  tenantId    String
  shopId      String
  customerId  String?
  totalAmount Float
  status      String      @default("COMPLETED") // COMPLETED, REFUNDED
  createdAt   DateTime    @default(now())

  items SaleItem[]
  @@index([tenantId])
  @@index([shopId])
}

model SaleItem {
  id         String   @id @default(uuid())
  saleId     String
  productId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model SaleReturn {
  id           String           @id @default(uuid())
  tenantId     String
  shopId       String
  saleId       String?
  customerId   String?
  returnNumber String           @unique
  totalAmount  Float
  refundAmount Float
  reason       String?
  status       String           @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime         @default(now())

  items SaleReturnItem[]
  @@index([tenantId])
  @@index([shopId])
}

model SaleReturnItem {
  id           String   @id @default(uuid())
  saleReturnId String
  productId    String
  serialNumber String?
  quantity     Int
  unitCost     Float
  refundAmount Float
  createdAt    DateTime @default(now())

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
}

model PaymentMethod {
  id            String    @id @default(uuid())
  tenantId      String
  shopId        String
  name          String
  type          String    // CASH, MOMO, BANK
  accountNumber String?
  bankName      String?
  balance       Float     @default(0)
  currency      String    @default("USD")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([shopId])
}

model PhysicalConfirmation {
  id          String   @id @default(uuid())
  tenantId    String
  shopId      String
  methodId    String
  confirmedBy String
  amount      Float
  notes       String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
}

model Transfer {
  id           String   @id @default(uuid())
  tenantId     String
  shopId       String
  fromMethodId String
  toMethodId   String
  amount       Float
  reference    String?
  status       String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
}

model Reconciliation {
  id             String   @id @default(uuid())
  tenantId       String
  shopId         String
  methodId       String
  systemBalance  Float
  physicalBalance Float
  difference     Float
  status         String   @default("RECONCILED") // RECONCILED, MISMATCHED
  reconciledBy   String
  notes          String?
  reconciledAt   DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
}

model OperationalDeposit {
  id           String   @id @default(uuid())
  tenantId     String
  shopId       String
  methodId     String
  amount       Float
  depositedBy  String
  notes        String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
}

model OperationalBalance {
  id              String   @id @default(uuid())
  tenantId        String
  shopId          String
  paymentMethodId String   @unique
  balance         Float    @default(0)
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
}

model Purchase {
  id         String        @id @default(uuid())
  tenantId   String
  shopId     String
  supplierId String?
  totalCost  Float
  status     String        @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  createdAt  DateTime      @default(now())

  items PurchaseItem[]
  @@index([tenantId])
  @@index([shopId])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Float
  totalCost  Float
  createdAt  DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model PurchaseReturn {
  id           String             @id @default(uuid())
  tenantId     String
  shopId       String
  purchaseId   String?
  supplierId   String?
  returnNumber String             @unique
  totalAmount  Float
  refundAmount Float
  reason       String?
  status       String             @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime           @default(now())

  items PurchaseReturnItem[]
  @@index([tenantId])
  @@index([shopId])
}

model PurchaseReturnItem {
  id              String   @id @default(uuid())
  purchaseReturnId String
  productId       String
  serialNumber    String?
  quantity        Int
  refundAmount    Float
  createdAt       DateTime @default(now())

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
}

model SupplierOrder {
  id          String             @id @default(uuid())
  tenantId    String
  shopId      String
  supplierId  String
  orderNumber String             @unique
  totalAmount Float
  status      String             @default("PENDING") // PENDING, APPROVED, RECEIVED, CANCELLED
  createdAt   DateTime           @default(now())

  items SupplierOrderItem[]
  @@index([tenantId])
  @@index([shopId])
}

model SupplierOrderItem {
  id              String   @id @default(uuid())
  supplierOrderId String
  productId       String
  quantity        Int
  unitPrice       Float
  total           Float
  createdAt       DateTime @default(now())

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  shopId     String?
  userId     String?
  action     String   // e.g. POST_JOURNAL, RECEIVE_GOODS, CLOSE_WORK_PERIOD
  resource   String   // e.g. JournalEntry, PurchaseOrder, WorkPeriod
  resourceId String?
  traceId    String?
  details    String?  // JSON or text summary
  createdAt  DateTime @default(now())
}

model RentalAgreement {
  id               String   @id @default(uuid())
  tenantId         String
  shopId           String
  inventoryItemId  String?  @unique // Optional: specific serialized item (one-to-one)
  productId        String?  // Optional: product-level (for non-serialized items)
  customerId       String?  // Optional: link to existing customer
  personName       String   // Required: person name (fallback if no customerId)
  personPhone      String?  // Optional: person phone
  agreementType    String   // OUTWARD_RENTAL, INWARD_CONSIGNMENT
  startDate        DateTime @default(now())
  expectedReturn   DateTime? // Optional: expected return date
  actualReturn     DateTime? // Set when returned/closed
  rentalFee        Float    @default(0) // Agreed rental fee (optional)
  ownerAgreedCost  Float    @default(0) // Owner agreed cost (for consignment)
  maintenanceCost  Float    @default(0) // Maintenance cost incurred
  status           String   @default("ACTIVE") // ACTIVE, RETURNED, SOLD, CANCELLED
  notes            String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inventoryItem    InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  @@index([tenantId])
  @@index([shopId])
  @@index([customerId])
  @@index([status])
}

