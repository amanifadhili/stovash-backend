// Accounting Service Database Schema
// Handles: Ledger Accounts, Journal Entries, Ledger, Posting Batches, Work Periods
// Owner of: accounting_db

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("ACCOUNTING_DATABASE_URL")
}

model LedgerAccount {
  id        String   @id @default(uuid())
  tenantId  String
  shopId    String
  code      String
  name      String
  type      String   // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  balance   Float    @default(0)
  parentId  String?  // Parent account for hierarchy
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?
  version   Int      @default(1)

  parent   LedgerAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children LedgerAccount[] @relation("AccountHierarchy")
  entries  LedgerEntry[]

  @@index([tenantId])
  @@index([shopId])
  @@index([parentId])
  @@index([code])
  @@index([type])
  @@map("ledger_accounts")
}

model JournalEntry {
  id           String        @id @default(uuid())
  tenantId     String
  shopId       String
  workPeriodId String
  description  String
  postedBy     String        // userId
  status       String        @default("DRAFT") // DRAFT, POSTED
  batchId      String?       // Reference to posting batch
  createdAt    DateTime      @default(now())
  createdBy    String?
  updatedAt    DateTime      @updatedAt
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?
  version      Int           @default(1)

  entries LedgerEntry[]
  batch   PostingBatch? @relation(fields: [batchId], references: [id])

  @@index([tenantId])
  @@index([shopId])
  @@index([workPeriodId])
  @@index([status])
  @@index([batchId])
  @@map("journal_entries")
}

model PostingBatch {
  id            String         @id @default(uuid())
  tenantId      String
  shopId        String
  workPeriodId  String?
  name          String
  description   String?
  status        String         @default("DRAFT") // DRAFT, POSTED
  postedBy      String?        // userId
  postedAt      DateTime?
  createdAt     DateTime       @default(now())
  createdBy     String?
  updatedAt     DateTime       @updatedAt
  updatedBy     String?
  deletedAt     DateTime?
  deletedBy     String?
  version       Int            @default(1)

  journalEntries JournalEntry[]

  @@index([tenantId])
  @@index([shopId])
  @@index([workPeriodId])
  @@index([status])
  @@map("posting_batches")
}

model LedgerEntry {
  id             String   @id @default(uuid())
  journalEntryId String
  accountId      String
  type           String   // DEBIT, CREDIT
  amount         Float
  createdAt      DateTime @default(now())

  journalEntry JournalEntry  @relation(fields: [journalEntryId], references: [id])
  account      LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([type])
  @@map("ledger_entries")
}

model WorkPeriod {
  id             String    @id @default(uuid())
  tenantId       String?
  shopId         String
  openedBy       String    // userId
  closedBy       String?   // userId
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  status         String    @default("OPEN") // OPEN, CLOSED, PENDING_CLOSING, PENDING_RECONCILIATION
  totalRevenue   Float    @default(0)
  totalExpense   Float    @default(0)
  netProfit      Float    @default(0)
  grossProfit    Float    @default(0)
  createdAt      DateTime  @default(now())
  createdBy      String?
  updatedAt      DateTime  @updatedAt
  updatedBy      String?
  version        Int       @default(1)

  @@index([tenantId])
  @@index([shopId])
  @@index([status])
  @@map("work_periods")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  shopId     String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  traceId    String?
  details    String?  // JSON or text summary
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
