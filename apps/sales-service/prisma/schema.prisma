// Sales Service Database Schema
// Handles: Sales, Quotations, Returns, Bonuses, Loan Sales

generator client {
  provider = "prisma-client-js"
  output   = "../dist/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("SALES_DATABASE_URL")
}

model Sale {
  id            String   @id @default(uuid())
  tenantId      String
  shopId        String
  workPeriodId  String?
  orderNumber   String   @unique
  customerId    String?
  totalAmount   Float
  totalCost     Float
  profit        Float
  paymentMethod String   @default("CASH") // CASH, CARD, CREDIT, LOAN
  status        String   @default("COMPLETED") // COMPLETED, CANCELLED, REFUNDED
  createdById   String? // userId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items    SaleItem[]
  payments SalePayment[]
  returns  SaleReturn[]

  @@index([tenantId])
  @@index([shopId])
  @@index([workPeriodId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id           String   @id @default(uuid())
  saleId       String
  productId    String
  serialNumber String
  quantity     Float
  unitCost     Float
  unitPrice    Float
  discount     Float    @default(0)
  tax          Float    @default(0)
  total        Float
  createdAt    DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SalePayment {
  id        String   @id @default(uuid())
  saleId    String
  amount    Float
  method    String // CASH, CARD, TRANSFER
  reference String?
  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@map("sale_payments")
}

model Quotation {
  id          String   @id @default(uuid())
  tenantId    String
  shopId      String
  quoteNumber String   @unique
  customerId  String?
  totalAmount Float
  validUntil  DateTime
  status      String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, EXPIRED, CONVERTED
  createdById String? // userId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items QuotationItem[]

  @@index([tenantId])
  @@index([shopId])
  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id          String   @id @default(uuid())
  quotationId String
  productId   String
  quantity    Float
  unitPrice   Float
  discount    Float    @default(0)
  total       Float
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

model SaleReturn {
  id           String   @id @default(uuid())
  tenantId     String
  shopId       String
  workPeriodId String?
  returnNumber String   @unique
  saleId       String?
  customerId   String?
  totalAmount  Float
  refundAmount Float
  reason       String?
  status       String   @default("PENDING") // PENDING, APPROVED, COMPLETED, REJECTED
  createdById  String? // userId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items SaleReturnItem[]
  Sale  Sale?            @relation(fields: [saleId], references: [id])

  @@index([tenantId])
  @@index([shopId])
  @@index([saleId])
  @@index([customerId])
  @@index([status])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String   @id @default(uuid())
  saleReturnId String
  productId    String
  serialNumber String
  quantity     Float
  unitCost     Float
  refundAmount Float
  createdAt    DateTime @default(now())

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id])

  @@index([saleReturnId])
  @@index([productId])
  @@map("sale_return_items")
}

model Bonus {
  id          String   @id @default(uuid())
  tenantId    String
  shopId      String
  customerId  String?
  amount      Float
  type        String // DISCOUNT, LOYALTY, PROMOTION
  description String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
  @@index([customerId])
  @@map("bonuses")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  shopId     String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  traceId    String?
  details    String?  // JSON or text summary
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
