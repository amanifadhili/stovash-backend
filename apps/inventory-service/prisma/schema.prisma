// Inventory Service Database Schema
// Handles: Products, Inventory Items, Transfers, Upgrades, Warranty Claims, Movements
// Owner of: inventory_db

generator client {
  provider = "prisma-client-js"
  output   = "../dist/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("INVENTORY_DATABASE_URL")
}

model Product {
  id             String   @id @default(uuid())
  tenantId       String
  sku            String
  name           String
  description    String?
  brandId        String?
  categoryId     String?
  productType    String   @default("PHYSICAL_GOOD") // PHYSICAL_GOOD, SERVICE
  trackingMethod String   @default("SERIALIZED")    // SERIALIZED, NON_SERIALIZED
  status         String   @default("ACTIVE")        // DRAFT, ACTIVE, INACTIVE, DISCONTINUED, ARCHIVED
  specifications Json?                              // [{key, value, type, sortOrder}]
  createdAt      DateTime @default(now())
  createdBy      String?
  updatedAt      DateTime @updatedAt
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?
  version        Int      @default(1)

  brand    Brand?        @relation(fields: [brandId], references: [id])
  category Category?     @relation(fields: [categoryId], references: [id])
  items    InventoryItem[]
  prices   ProductPrice[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model InventoryItem {
  id              String   @id @default(uuid())
  tenantId        String
  shopId          String
  productId       String
  serialNumber    String
  purchaseCost    Float
  status          String   @default("CREATED") // CREATED, RECEIVED, AVAILABLE, RESERVED, SOLD, RETURNED, DAMAGED, LOST, STOLEN, DISPOSED
  capitalizedCost Float    @default(0) // Total capitalized upgrade costs
  createdAt       DateTime @default(now())
  createdBy       String?
  updatedAt       DateTime @updatedAt
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?
  version         Int      @default(1)

  product Product          @relation(fields: [productId], references: [id])
  upgrades InventoryUpgrade[]

  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@index([shopId])
  @@index([productId])
  @@index([status])
  @@map("inventory_items")
}

model InventoryUpgrade {
  id              String   @id @default(uuid())
  tenantId        String
  shopId          String
  inventoryItemId String
  upgradeType     String   // SSD, RAM, etc.
  description     String?
  cost            Float
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([tenantId])
  @@index([shopId])
  @@index([inventoryItemId])
  @@index([upgradeType])
  @@map("inventory_upgrades")
}

model InventoryTransfer {
  id             String   @id @default(uuid())
  tenantId       String
  fromShopId     String
  toShopId       String
  transferNumber String   @unique
  serialNumber   String
  status         String   @default("COMPLETED") // IN_TRANSIT, COMPLETED, CANCELLED
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([fromShopId])
  @@index([toShopId])
  @@index([status])
  @@map("inventory_transfers")
}

model WarrantyClaim {
  id               String   @id @default(uuid())
  tenantId         String
  shopId           String
  serialNumber     String
  customerName     String?
  issueDescription String
  status           String   @default("LOGGED") // LOGGED, IN_REPAIR, REPLACED, CLOSED
  resolution       String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@index([shopId])
  @@index([serialNumber])
  @@index([status])
  @@map("warranty_claims")
}

model Category {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  createdBy String?

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([tenantId])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  createdBy   String?

  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("brands")
}

model ProductPrice {
  id           String   @id @default(uuid())
  productId    String
  tenantId     String
  sellingPrice Float
  validFrom    DateTime @default(now())
  validTo      DateTime?
  createdAt    DateTime @default(now())
  createdBy    String?

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([tenantId])
  @@map("product_prices")
}

model InventoryMovement {
  id              String   @id @default(uuid())
  tenantId        String
  shopId          String
  inventoryItemId String
  movementType    String   // IN, OUT, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT
  quantity        Float    @default(1)
  referenceId     String?
  referenceType   String?
  createdAt       DateTime @default(now())
  createdBy       String?

  @@index([tenantId])
  @@index([shopId])
  @@index([inventoryItemId])
  @@index([movementType])
  @@map("inventory_movements")
}

model InventoryAdjustment {
  id              String   @id @default(uuid())
  tenantId        String
  shopId          String
  inventoryItemId String
  adjustmentType  String   // DAMAGE, LOSS, THEFT, DISPOSAL, CORRECTION
  reason          String?
  quantity        Float    @default(1)
  createdAt       DateTime @default(now())
  createdBy       String?

  @@index([tenantId])
  @@index([shopId])
  @@index([inventoryItemId])
  @@index([adjustmentType])
  @@map("inventory_adjustments")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  shopId     String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  traceId    String?
  details    String?  // JSON or text summary
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
