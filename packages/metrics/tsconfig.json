{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": false,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": false,
    "noResolve": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
