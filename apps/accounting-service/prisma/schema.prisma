generator client {
  provider = "prisma-client-js"
  output   = "../dist/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("ACCOUNTING_DATABASE_URL")
}

model LedgerAccount {
  id        String          @id @default(uuid())
  tenantId  String
  shopId    String
  code      String
  name      String
  type      String
  balance   Float           @default(0)
  parentId  String?
  createdAt DateTime        @default(now())
  createdBy String?
  updatedAt DateTime        @updatedAt
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?
  version   Int             @default(1)
  parent    LedgerAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children  LedgerAccount[] @relation("AccountHierarchy")
  entries   LedgerEntry[]

  @@index([tenantId])
  @@index([shopId])
  @@index([parentId])
  @@index([code])
  @@index([type])
  @@map("ledger_accounts")
}

model JournalEntry {
  id           String        @id @default(uuid())
  tenantId     String
  shopId       String
  workPeriodId String
  description  String
  postedBy     String
  status       String        @default("DRAFT")
  batchId      String?
  createdAt    DateTime      @default(now())
  createdBy    String?
  updatedAt    DateTime      @updatedAt
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?
  version      Int           @default(1)
  batch        PostingBatch? @relation(fields: [batchId], references: [id])
  entries      LedgerEntry[]

  @@index([tenantId])
  @@index([shopId])
  @@index([workPeriodId])
  @@index([status])
  @@index([batchId])
  @@map("journal_entries")
}

model PostingBatch {
  id             String         @id @default(uuid())
  tenantId       String
  shopId         String
  workPeriodId   String?
  name           String
  description    String?
  status         String         @default("DRAFT")
  postedBy       String?
  postedAt       DateTime?
  createdAt      DateTime       @default(now())
  createdBy      String?
  updatedAt      DateTime       @updatedAt
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?
  version        Int            @default(1)
  journalEntries JournalEntry[]

  @@index([tenantId])
  @@index([shopId])
  @@index([workPeriodId])
  @@index([status])
  @@map("posting_batches")
}

model LedgerEntry {
  id             String        @id @default(uuid())
  journalEntryId String
  accountId      String
  type           String
  amount         Float
  createdAt      DateTime      @default(now())
  account        LedgerAccount @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([type])
  @@map("ledger_entries")
}

model WorkPeriod {
  id           String    @id @default(uuid())
  tenantId     String?
  shopId       String
  openedBy     String
  closedBy     String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  status       String    @default("OPEN")
  totalRevenue Float     @default(0)
  totalExpense Float     @default(0)
  netProfit    Float     @default(0)
  grossProfit  Float     @default(0)
  createdAt    DateTime  @default(now())
  createdBy    String?
  updatedAt    DateTime  @updatedAt
  updatedBy    String?
  version      Int       @default(1)

  @@index([tenantId])
  @@index([shopId])
  @@index([status])
  @@map("work_periods")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  shopId     String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  traceId    String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
