// Purchase Service Database Schema
// Comprehensive Purchase Domain per purchase-logic.md

generator client {
  provider = "prisma-client-js"
  output   = "../dist/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("PURCHASE_DATABASE_URL")
}

enum PurchaseCommercialStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum PurchaseReceivingStatus {
  NOT_RECEIVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PurchaseAccountingStatus {
  UNPOSTED
  POSTED
  REVERSED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHECK
  CREDIT
  OTHER
}

enum ReceivingItemCondition {
  ACCEPTED
  REJECTED
  DAMAGED
  WRONG_ITEM
}

model Purchase {
  id                 String                    @id @default(uuid())
  tenantId           String
  shopId             String
  purchaseNumber     String                    @unique
  supplierId         String
  supplierName       String
  supplierContact    String?
  supplierAddress    String?
  supplierTaxId      String?
  purchaseDate       DateTime                  @default(now())
  supplierInvoiceNo  String?
  currency           String                    @default("RWF")
  exchangeRate       Float                     @default(1.0)
  commercialStatus   PurchaseCommercialStatus  @default(DRAFT)
  receivingStatus    PurchaseReceivingStatus   @default(NOT_RECEIVED)
  paymentStatus      PurchasePaymentStatus     @default(UNPAID)
  accountingStatus   PurchaseAccountingStatus  @default(UNPOSTED)
  subtotal           Float                     @default(0)
  discountTotal      Float                     @default(0)
  taxTotal           Float                     @default(0)
  otherCostTotal     Float                     @default(0)
  grandTotal         Float                     @default(0)
  amountPaid         Float                     @default(0)
  amountOutstanding  Float                     @default(0)
  notes              String?
  approvedById       String?
  approvedAt         DateTime?
  createdById        String
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  items          PurchaseItem[]
  receivedItems  PurchaseReceivedItem[]
  receivings     PurchaseReceiving[]
  payments       PurchasePayment[]
  returns        PurchaseReturn[]
  documents      PurchaseDocument[]
  history        PurchaseHistory[]

  @@index([tenantId])
  @@index([shopId])
  @@index([supplierId])
  @@index([commercialStatus])
  @@index([receivingStatus])
  @@index([paymentStatus])
  @@index([accountingStatus])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id                 String   @id @default(uuid())
  purchaseId         String
  productId          String
  productName        String
  productSku         String
  productTracking    String
  orderedQty         Float
  receivedQty        Float    @default(0)
  acceptedQty        Float    @default(0)
  rejectedQty        Float    @default(0)
  returnedQty        Float    @default(0)
  unitPrice          Float
  discountAmount     Float    @default(0)
  discountType       String?  // PERCENTAGE, FIXED
  taxRate            Float    @default(0)
  taxAmount          Float    @default(0)
  otherCosts         Float    @default(0)
  lineTotal          Float
  acquisitionCost    Float    @default(0)  // per unit, includes allocated costs
  purchaseSpecs      String?  // JSON array of spec key/value/type
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  purchase         Purchase              @relation(fields: [purchaseId], references: [id])
  receivedItems    PurchaseReceivedItem[]
  returnItems      PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model PurchaseReceivedItem {
  id                 String                   @id @default(uuid())
  purchaseId         String
  purchaseItemId     String
  receivingId        String
  serialNumber       String?
  imei1              String?
  imei2              String?
  condition          ReceivingItemCondition   @default(ACCEPTED)
  actualSpecs        String?                  // JSON array of actual spec key/value/type
  unitAcquisitionCost Float
  notes              String?
  createdAt          DateTime                 @default(now())

  purchase         Purchase           @relation(fields: [purchaseId], references: [id])
  purchaseItem     PurchaseItem       @relation(fields: [purchaseItemId], references: [id])
  receiving        PurchaseReceiving  @relation(fields: [receivingId], references: [id])

  @@index([purchaseId])
  @@index([purchaseItemId])
  @@index([receivingId])
  @@index([serialNumber])
  @@index([imei1])
  @@index([imei2])
  @@map("purchase_received_items")
}

model PurchaseReceiving {
  id              String   @id @default(uuid())
  purchaseId      String
  receivingNumber String   @unique
  receivedById    String
  receivedAt      DateTime @default(now())
  receivedAtShop  String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchase        Purchase                 @relation(fields: [purchaseId], references: [id])
  receivedItems   PurchaseReceivedItem[]

  @@index([purchaseId])
  @@index([receivedById])
  @@index([receivedAt])
  @@map("purchase_receivings")
}

model PurchasePayment {
  id              String        @id @default(uuid())
  purchaseId      String
  paymentNumber   String        @unique
  amount          Float
  currency        String        @default("RWF")
  exchangeRate    Float         @default(1.0)
  paymentMethod   PaymentMethod
  accountId       String?       // cash register, bank account, mobile money account
  accountName     String?
  reference       String?       // transaction reference
  paidById        String
  paidAt          DateTime      @default(now())
  notes           String?
  accountingRef   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  purchase Purchase @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
  @@index([paidById])
  @@index([paidAt])
  @@index([paymentMethod])
  @@map("purchase_payments")
}

model PurchaseReturn {
  id              String   @id @default(uuid())
  tenantId        String
  shopId          String
  purchaseId      String?
  supplierId      String
  returnNumber    String   @unique
  totalAmount     Float    @default(0)
  refundAmount    Float    @default(0)
  reason          String?
  status          String   @default("PENDING") // PENDING, APPROVED, COMPLETED, REJECTED
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           PurchaseReturnItem[]
  purchase        Purchase?            @relation(fields: [purchaseId], references: [id])

  @@index([tenantId])
  @@index([shopId])
  @@index([purchaseId])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id                String   @id @default(uuid())
  purchaseReturnId  String
  purchaseItemId    String?
  productId         String
  productName       String
  productSku        String
  receivedItemId    String?  // links to specific serial/IMEI
  serialNumber      String?
  imei1             String?
  imei2             String?
  quantity          Float
  refundAmount      Float
  condition         String?  // GOOD, DAMAGED, etc.
  reason            String?
  createdAt         DateTime @default(now())

  purchaseReturn    PurchaseReturn          @relation(fields: [purchaseReturnId], references: [id])
  purchaseItem      PurchaseItem?           @relation(fields: [purchaseItemId], references: [id])

  @@index([purchaseReturnId])
  @@index([purchaseItemId])
  @@index([receivedItemId])
  @@index([serialNumber])
  @@map("purchase_return_items")
}

model PurchaseDocument {
  id              String    @id @default(uuid())
  purchaseId      String
  purchase        Purchase  @relation(fields: [purchaseId], references: [id])
  documentType    String   // INVOICE, QUOTATION, PO, DELIVERY_NOTE, GRN, RECEIPT, WARRANTY, OTHER
  fileName        String
  fileUrl         String
  fileSize        Int?
  mimeType        String?
  uploadedById    String
  uploadedAt      DateTime @default(now())
  notes           String?

  @@index([purchaseId])
  @@index([documentType])
  @@map("purchase_documents")
}

model PurchaseHistory {
  id              String    @id @default(uuid())
  purchaseId      String
  purchase        Purchase  @relation(fields: [purchaseId], references: [id])
  eventType       String   // CREATED, CONFIRMED, ITEM_ADDED, RECEIVING_STARTED, RECEIVING_COMPLETED, PAYMENT_RECEIVED, RETURN_INITIATED, RETURN_COMPLETED, STATUS_CHANGED, CANCELLED, CORRECTED
  eventData       String   // JSON
  userId          String
  userName        String
  traceId         String?
  createdAt       DateTime @default(now())

  @@index([purchaseId])
  @@index([eventType])
  @@index([createdAt])
  @@map("purchase_history")
}

model SupplierOrder {
  id           String   @id @default(uuid())
  tenantId     String
  shopId       String
  supplierId   String
  orderNumber  String   @unique
  totalAmount  Float
  status       String   @default("PENDING") // PENDING, SENT, RECEIVED, CANCELLED
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items SupplierOrderItem[]

  @@index([tenantId])
  @@index([shopId])
  @@index([supplierId])
  @@index([status])
  @@map("supplier_orders")
}

model SupplierOrderItem {
  id               String   @id @default(uuid())
  supplierOrderId  String
  productId        String
  quantity         Float
  unitPrice        Float
  total            Float
  createdAt        DateTime @default(now())

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id])

  @@index([supplierOrderId])
  @@index([productId])
  @@map("supplier_order_items")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  shopId     String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  traceId    String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}