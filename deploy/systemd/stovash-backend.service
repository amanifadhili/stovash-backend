[Unit]
Description=STOVASH API (gateway + services)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/stovash/backend/current
EnvironmentFile=-/home/deploy/stovash/backend/shared/.env
Environment=NODE_ENV=production
Environment=PORT=5051
Environment=PATH=/usr/bin:/bin
ExecStart=/usr/bin/bash -c 'if [ -f dist/server.js ]; then exec /usr/bin/node dist/server.js; else exec /usr/bin/npx tsx server.ts; fi'
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
