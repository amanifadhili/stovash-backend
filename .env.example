# .env.example
PORT=3000

# Database
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/electronic_shop

# Redis Cache
REDIS_URI=redis://localhost:6379

# RabbitMQ
RABBITMQ_URI=amqp://localhost:5672

# MinIO / Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=electronic-shop-bucket
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/electronic_shop
CORS_ORIGINS=https://stovash.com,https://www.stovash.com
# Required in production for GET /metrics (Prometheus). Unauthenticated scrapes get 401.
METRICS_TOKEN=change-me-metrics-token
# JSON body: 1mb default; purchase photo commands may use up to 25mb
GATEWAY_BODY_LIMIT=1mb
GATEWAY_UPLOAD_BODY_LIMIT=25mb
# /ready dependency TCP probe timeout per service
READY_TIMEOUT_MS=1200
# ssh root@109.123.245.58

#