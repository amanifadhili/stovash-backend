// Treasury Service Database Schema
// Handles: Payment Methods, Transfers, Physical Confirmations

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("TREASURY_DATABASE_URL")
}

/// LEGACY (Phase 10): unread. Engine money lives on PhysicalAccount + TreasuryMovement (derived Σ).
/// DROP SQL is in electronic-shop/docs/FINANCIAL_BACKUP_RESTORE.md — do not run until a verified backup and operator sign-off.
model PaymentMethod {
  id          String   @id @default(uuid())
  tenantId    String
  shopId      String
  name        String
  type        String   // CASH, BANK, MOBILE, CARD
  accountNumber String?
  bankName    String?
  balance     Float    @default(0)
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outgoingTransfers Transfer[] @relation("FromMethod")
  incomingTransfers Transfer[] @relation("ToMethod")
  confirmations PhysicalConfirmation[]
  deposits    OperationalDeposit[]
  reconciliations Reconciliation[]
  loans       TreasuryLoan[]
  loanRepayments TreasuryLoanRepayment[]

  @@index([tenantId])
  @@index([shopId])
  @@index([type])
  @@map("payment_methods")
}

model Transfer {
  id              String   @id @default(uuid())
  tenantId        String
  shopId          String
  fromMethodId    String
  toMethodId      String
  amount          Float
  reference       String?
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED
  approvedBy      String?  // userId
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fromMethod      PaymentMethod @relation("FromMethod", fields: [fromMethodId], references: [id])
  toMethod       PaymentMethod @relation("ToMethod", fields: [toMethodId], references: [id])

  @@index([tenantId])
  @@index([shopId])
  @@index([fromMethodId])
  @@index([toMethodId])
  @@index([status])
  @@map("transfers")
}

model PhysicalConfirmation {
  id          String   @id @default(uuid())
  tenantId    String
  shopId      String
  methodId    String
  confirmedBy String   // userId
  amount      Float
  notes       String?
  confirmedAt DateTime @default(now())

  method      PaymentMethod @relation(fields: [methodId], references: [id])

  @@index([tenantId])
  @@index([shopId])
  @@index([methodId])
  @@index([confirmedAt])
  @@map("physical_confirmations")
}

model OperationalDeposit {
  id          String   @id @default(uuid())
  tenantId    String
  shopId      String
  methodId    String
  amount      Float
  depositedBy String   // userId
  notes       String?
  depositedAt DateTime @default(now())

  method      PaymentMethod @relation(fields: [methodId], references: [id])

  @@index([tenantId])
  @@index([shopId])
  @@index([methodId])
  @@index([depositedAt])
  @@map("operational_deposits")
}

model Reconciliation {
  id          String   @id @default(uuid())
  tenantId    String
  shopId      String
  methodId    String
  systemBalance Float
  physicalBalance Float
  difference  Float
  reconciledBy String   // userId
  reconciledAt DateTime @default(now())
  notes       String?

  method      PaymentMethod @relation(fields: [methodId], references: [id])

  @@index([tenantId])
  @@index([shopId])
  @@index([methodId])
  @@index([reconciledAt])
  @@map("reconciliations")
}

model TreasuryLoan {
  id            String   @id @default(uuid())
  tenantId      String
  shopId        String
  direction     String   // BORROWED (business borrows), LENT (business lends)
  counterparty  String
  principal     Float
  outstanding   Float
  methodId      String
  status        String   @default("ACTIVE") // ACTIVE, REPAID
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  method      PaymentMethod @relation(fields: [methodId], references: [id])
  repayments  TreasuryLoanRepayment[]

  @@index([tenantId])
  @@index([shopId])
  @@index([direction])
  @@index([status])
  @@map("treasury_loans")
}

model TreasuryLoanRepayment {
  id        String   @id @default(uuid())
  tenantId  String
  shopId    String
  loanId    String
  methodId  String
  amount    Float
  notes     String?
  createdBy String?
  createdAt DateTime @default(now())

  loan   TreasuryLoan  @relation(fields: [loanId], references: [id])
  method PaymentMethod @relation(fields: [methodId], references: [id])

  @@index([tenantId])
  @@index([shopId])
  @@index([loanId])
  @@map("treasury_loan_repayments")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  shopId     String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  traceId    String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Phase 3 fund tree. Balances are never stored here — they are Σ of treasury
/// movements (Phase 5). Until then every derived balance is 0.
model LogicalFund {
  id        String            @id @default(uuid())
  tenantId  String
  shopId    String
  code      String
  name      String
  currency  String            @default("RWF")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  accounts  PhysicalAccount[]

  @@unique([tenantId, shopId, code])
  @@index([tenantId, shopId])
  @@map("logical_funds")
}

model PhysicalAccount {
  id        String      @id @default(uuid())
  tenantId  String
  shopId    String
  fundId    String
  kind      String
  code      String
  name      String
  currency  String      @default("RWF")
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  createdBy String?
  updatedAt DateTime    @updatedAt
  fund      LogicalFund @relation(fields: [fundId], references: [id])
  outgoing  TreasuryMovement[] @relation("MovementFrom")
  incoming  TreasuryMovement[] @relation("MovementTo")
  reconCounts ReconciliationCount[]

  @@unique([tenantId, shopId, code])
  @@index([tenantId, shopId])
  @@index([fundId])
  @@index([kind])
  @@map("physical_accounts")
}

/// Phase 5 money movements. Totals are Σ incoming − Σ outgoing. No stored SoT column.
model TreasuryMovement {
  id                     String           @id @default(uuid())
  tenantId               String
  shopId                 String
  movementType           String
  fromPhysicalId         String?
  toPhysicalId           String?
  amountMinor            BigInt
  financialTransactionId String
  journalId              String?
  occurredOn             DateTime         @db.Date
  idempotencyKey         String
  reason                 String?
  notes                  String?
  originalMovementId     String?
  createdBy              String?
  createdAt              DateTime         @default(now())
  fromAccount            PhysicalAccount? @relation("MovementFrom", fields: [fromPhysicalId], references: [id])
  toAccount              PhysicalAccount? @relation("MovementTo", fields: [toPhysicalId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, shopId, occurredOn])
  @@index([tenantId, shopId, fromPhysicalId])
  @@index([tenantId, shopId, toPhysicalId])
  @@index([financialTransactionId])
  @@index([originalMovementId])
  @@map("treasury_movements")
}

/// Phase 7 calendar day. Identity is tenant + shop + date. Never opened or closed by a button.
model FinancialPeriod {
  id        String           @id @default(uuid())
  tenantId  String
  shopId    String
  date      DateTime         @db.Date
  createdAt DateTime         @default(now())
  snapshots PeriodSnapshot[]

  @@unique([tenantId, shopId, date])
  @@map("financial_periods")
}

/// Opening + inflows − outflows ± adjustments = closing. Derived from TreasuryMovement, then stored.
model PeriodSnapshot {
  id               String          @id @default(uuid())
  periodId         String
  scopeType        String
  scopeKey         String
  openingMinor     BigInt
  inflowsMinor     BigInt
  outflowsMinor    BigInt
  adjustmentsMinor BigInt
  closingMinor     BigInt
  period           FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, scopeType, scopeKey])
  @@index([periodId])
  @@map("period_snapshots")
}

model TreasuryObligation {
  id                     String   @id @default(uuid())
  tenantId               String
  shopId                 String
  kind                   String
  lenderFundCode         String?
  borrowerFundCode       String?
  partyName              String
  outstandingMinor       BigInt
  financialTransactionId String
  status                 String   @default("OPEN")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([tenantId, shopId, kind])
  @@index([financialTransactionId])
  @@map("treasury_obligations")
}

model ReconciliationCount {
  id                     String          @id @default(uuid())
  tenantId               String
  shopId                 String
  physicalAccountId      String
  expectedMinor          BigInt
  countedMinor           BigInt
  differenceMinor        BigInt
  status                 String          @default("COUNTED")
  countedBy              String
  notes                  String?
  reason                 String?
  approvedBy             String?
  approvedAt             DateTime?
  adjustmentMovementId   String?
  createdAt              DateTime        @default(now())
  account                PhysicalAccount @relation(fields: [physicalAccountId], references: [id])

  @@index([tenantId, shopId, status])
  @@index([physicalAccountId])
  @@map("reconciliation_counts")
}
