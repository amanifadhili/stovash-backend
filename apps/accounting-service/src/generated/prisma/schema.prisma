generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("ACCOUNTING_DATABASE_URL")
}

model LedgerAccount {
  id        String          @id @default(uuid())
  tenantId  String
  shopId    String
  code      String
  name      String
  type      String
  balance   Float           @default(0)
  parentId  String?
  createdAt DateTime        @default(now())
  createdBy String?
  updatedAt DateTime        @updatedAt
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?
  version   Int             @default(1)
  parent    LedgerAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children  LedgerAccount[] @relation("AccountHierarchy")
  entries   LedgerEntry[]

  @@index([tenantId])
  @@index([shopId])
  @@index([parentId])
  @@index([code])
  @@index([type])
  @@map("ledger_accounts")
}

model JournalEntry {
  id           String        @id @default(uuid())
  tenantId     String
  shopId       String
  workPeriodId String
  description  String
  postedBy     String
  status       String        @default("DRAFT")
  batchId      String?
  createdAt    DateTime      @default(now())
  createdBy    String?
  updatedAt    DateTime      @updatedAt
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?
  version      Int           @default(1)
  batch        PostingBatch? @relation(fields: [batchId], references: [id])
  entries      LedgerEntry[]

  @@index([tenantId])
  @@index([shopId])
  @@index([workPeriodId])
  @@index([status])
  @@index([batchId])
  @@map("journal_entries")
}

model PostingBatch {
  id             String         @id @default(uuid())
  tenantId       String
  shopId         String
  workPeriodId   String?
  name           String
  description    String?
  status         String         @default("DRAFT")
  postedBy       String?
  postedAt       DateTime?
  createdAt      DateTime       @default(now())
  createdBy      String?
  updatedAt      DateTime       @updatedAt
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?
  version        Int            @default(1)
  journalEntries JournalEntry[]

  @@index([tenantId])
  @@index([shopId])
  @@index([workPeriodId])
  @@index([status])
  @@map("posting_batches")
}

model LedgerEntry {
  id             String        @id @default(uuid())
  journalEntryId String
  accountId      String
  type           String
  amount         Float
  createdAt      DateTime      @default(now())
  account        LedgerAccount @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([type])
  @@map("ledger_entries")
}

model WorkPeriod {
  id           String    @id @default(uuid())
  tenantId     String?
  shopId       String
  openedBy     String
  closedBy     String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  status       String    @default("OPEN")
  totalRevenue Float     @default(0)
  totalExpense Float     @default(0)
  netProfit    Float     @default(0)
  grossProfit  Float     @default(0)
  createdAt    DateTime  @default(now())
  createdBy    String?
  updatedAt    DateTime  @updatedAt
  updatedBy    String?
  version      Int       @default(1)

  @@index([tenantId])
  @@index([shopId])
  @@index([status])
  @@map("work_periods")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  shopId     String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  traceId    String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([shopId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Canonical money event. Phase 2 persists the typed row only — no journal legs,
/// no LedgerAccount.balance / till updates. Amount is integer RWF cents (BigInt).
model FinancialTransaction {
  id                    String   @id @default(uuid())
  tenantId              String
  shopId                String
  type                  String
  occurredOn            DateTime @db.Date
  occurredAt            DateTime @default(now())
  actorUserId           String?
  sourceDomain          String
  sourceCommand         String
  sourceId              String
  idempotencyKey        String
  amountMinor           BigInt
  currency              String   @default("RWF")
  description           String?
  reason                String?
  originalTransactionId String?
  status                String   @default("POSTED")
  metadata              Json?
  createdAt             DateTime @default(now())
  createdBy             String?
  updatedAt             DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, shopId, occurredOn])
  @@index([tenantId, sourceId])
  @@index([originalTransactionId])
  @@map("financial_transactions")
}

/// Phase 4 engine chart. Balances are derived from PostedJournalLine, never stored.
model ChartAccount {
  id        String              @id @default(uuid())
  tenantId  String
  shopId    String
  code      String
  name      String
  type      String
  fundCode  String?
  createdAt DateTime            @default(now())
  lines     PostedJournalLine[]

  @@unique([tenantId, shopId, code])
  @@index([tenantId, shopId, type])
  @@map("chart_accounts")
}

model PostedJournal {
  id                     String              @id @default(uuid())
  tenantId               String
  shopId                 String
  financialTransactionId String              @unique
  description            String
  status                 String              @default("POSTED")
  postedBy               String
  occurredOn             DateTime            @db.Date
  createdAt              DateTime            @default(now())
  lines                  PostedJournalLine[]

  @@index([tenantId, shopId, occurredOn])
  @@map("posted_journals")
}

model PostedJournalLine {
  id          String        @id @default(uuid())
  journalId   String
  accountId   String
  side        String
  amountMinor BigInt
  journal     PostedJournal @relation(fields: [journalId], references: [id])
  account     ChartAccount  @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId])
  @@map("posted_journal_lines")
}

model Obligation {
  id                     String   @id @default(uuid())
  tenantId               String
  shopId                 String
  kind                   String
  partyName              String
  outstandingMinor       BigInt
  financialTransactionId String
  status                 String   @default("OPEN")
  createdAt              DateTime @default(now())

  @@index([tenantId, shopId, kind])
  @@index([financialTransactionId])
  @@map("obligations")
}

model ProfitAllocation {
  id               String   @id @default(uuid())
  tenantId         String
  shopId           String
  earnedMinor      BigInt   @default(0)
  transferredMinor BigInt   @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, shopId])
  @@map("profit_allocations")
}
